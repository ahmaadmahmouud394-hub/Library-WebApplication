@model Library_WebApplication.Models.Book

@{
    ViewData["Title"] = "Create";
}
@{
    Layout = "_DataLayout";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-container {
        background: #fff;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
        max-width: 500px;
        width: 100%;
    }

    .form-title {
        text-align: center;
        font-size: 1.8rem;
        font-weight: 600;
        color: #343a40;
        margin-bottom: 1rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    label {
        font-weight: 500;
        color: #495057;
        margin-bottom: 0.3rem;
    }

    .form-control {
        border-radius: 6px;
        padding: 0.6rem;
        font-size: 0.95rem;
        border: 1px solid #ced4da;
    }

        .form-control:focus {
            border-color: #80bdff;
            box-shadow: 0 0 5px rgba(0,123,255,0.25);
        }

    .btn {
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 0.95rem;
        transition: all 0.2s ease-in-out;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #565e64;
        }
</style>

<div class="d-flex justify-content-center align-items-center vh-auto">
    <div class="form-container">
        <h1 class="form-title">📖 Create Book</h1>
        <hr />
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tipology"></label>
                <select asp-for="IdTipology" class="form-control" asp-items="ViewBag.TipologyId"></select>
            </div>

            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Author"></label>
                <select asp-for="IdAuthor" class="form-control" asp-items="ViewBag.AuthorId"></select>
            </div>

            <div class="form-group">
                <label asp-for="Pubblisher"></label>
                <select asp-for="IdPubblisher" class="form-control" asp-items="ViewBag.PubblisherId"></select>
            </div>

            <div class="form-group">
                <label asp-for="PublishingDate"></label>
                <input asp-for="PublishingDate" type="date" class="form-control" />
                <span asp-validation-for="PublishingDate" class="text-danger"></span>
            </div>

            <div class="form-group text-center mt-4">
                <input type="submit" value="Create" class="btn btn-primary w-100" />
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Index" class="btn btn-secondary w-100">⬅ Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
